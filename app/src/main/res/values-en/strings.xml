<resources>
    <string name="app_name">Teranga Shield</string>

    <string name="onboarding_welcome_title">Welcome to Teranga Shield</string>
    <string name="onboarding_welcome_body">Teranga Shield protects you from fraudulent calls and texts, entirely on your phone, with no internet connection required.</string>
    <string name="onboarding_next">Continue</string>
    <string name="onboarding_back">Back</string>

    <string name="onboarding_country_title">Your country</string>
    <string name="onboarding_country_body">We use this to display phone numbers in the right format.</string>
    <string name="onboarding_language_title">App language</string>
    <string name="onboarding_language_body">Choose the language of the interface and of detection. It can be different from your country.</string>

    <string name="onboarding_why_title">Why Teranga Shield needs to become your calls and SMS app</string>
    <string name="onboarding_why_body">To catch a scam as it happens, the app needs to be able to check incoming calls and messages before they reach you. That\'s why Android requires it to become your default calling and messaging app.</string>

    <string name="onboarding_privacy_title">Everything stays on your phone</string>
    <string name="onboarding_privacy_body">Analysis of calls and messages happens 100%% locally. No conversation is ever sent to a server.</string>

    <string name="onboarding_trusted_contact_title">Your trusted contact</string>
    <string name="onboarding_trusted_contact_body">If a high risk is detected, this person will receive a text with a risk score — never the content of the conversation.</string>
    <string name="onboarding_first_name_label">First name</string>
    <string name="trusted_contact_name_label">Name</string>
    <string name="trusted_contact_phone_label">Phone number</string>

    <string name="consent_title">Before you continue</string>
    <string name="consent_default_apps_body">Teranga Shield will become your default calling and messaging app. It checks calls and messages from unknown numbers to detect scams. Nothing is sent over the internet.</string>
    <string name="consent_mic_title">Audio analysis (microphone)</string>
    <string name="consent_mic_body">If you turn on speakerphone during a call with an unknown number, Teranga Shield can listen to the conversation to detect a scam, only during that call, only locally on your phone. You can turn this off anytime in Settings.</string>
    <string name="consent_checkbox_label">I have read and accept these terms</string>
    <string name="consent_accept">I accept</string>
    <string name="consent_decline">I do not accept</string>

