<resources>
    <string name="app_name">Teranga Shield</string>

    <!-- Onboarding : bienvenue -->
    <string name="onboarding_welcome_title">Bienvenue sur Teranga Shield</string>
    <string name="onboarding_welcome_body">Teranga Shield vous protège contre les appels et SMS frauduleux, entièrement sur votre téléphone, sans connexion internet obligatoire.</string>
    <string name="onboarding_next">Continuer</string>
    <string name="onboarding_back">Retour</string>

    <!-- Onboarding : pays / langue -->
    <string name="onboarding_country_title">Votre pays</string>
    <string name="onboarding_country_body">Nous l\'utilisons pour afficher les numéros de téléphone dans le bon format.</string>
    <string name="onboarding_language_title">Langue de l\'application</string>
    <string name="onboarding_language_body">Choisissez la langue de l\'interface et de la détection. Elle peut être différente de votre pays.</string>

    <!-- Onboarding : pourquoi les rôles par défaut -->
    <string name="onboarding_why_title">Pourquoi Teranga Shield doit devenir votre app d\'appels et de SMS</string>
    <string name="onboarding_why_body">Pour détecter une arnaque au moment où elle arrive, l\'application doit pouvoir examiner les appels et messages entrants avant qu\'ils ne vous atteignent. C\'est pour cela qu\'Android exige qu\'elle devienne votre gestionnaire d\'appels et de SMS par défaut.</string>

    <!-- Onboarding : confidentialité -->
    <string name="onboarding_privacy_title">Tout reste sur votre téléphone</string>
    <string name="onboarding_privacy_body">L\'analyse des appels et des messages se fait à 100%% localement. Aucune conversation n\'est envoyée à un serveur, jamais.</string>

    <!-- Onboarding : contact de confiance -->
    <string name="onboarding_trusted_contact_title">Votre contact de confiance</string>
    <string name="onboarding_trusted_contact_body">En cas de risque élevé détecté, cette personne recevra un SMS avec un score de risque — jamais le contenu de la conversation.</string>
    <string name="onboarding_first_name_label">Prénom</string>
    <string name="trusted_contact_name_label">Nom</string>
    <string name="trusted_contact_phone_label">Numéro de téléphone</string>

    <!-- Écran de consentement dédié -->
    <string name="consent_title">Avant de continuer</string>
    <string name="consent_default_apps_body">Teranga Shield va devenir votre application d\'appels et de SMS par défaut. Elle examine les appels et messages provenant de numéros inconnus pour détecter une arnaque. Rien n\'est envoyé sur internet.</string>
    <string name="consent_mic_title">Analyse audio (micro)</string>
    <string name="consent_mic_body">Si vous activez le haut-parleur pendant un appel avec un numéro inconnu, Teranga Shield peut écouter la conversation pour détecter une arnaque, uniquement pendant cet appel, uniquement en local sur votre téléphone. Vous pouvez désactiver cette fonction à tout moment dans les Réglages.</string>
    <string name="consent_checkbox_label">J\'ai lu et j\'accepte ces conditions</string>
    <string name="consent_accept">J\'accepte</string>
    <string name="consent_decline">Je n\'accepte pas</string>

